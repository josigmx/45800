{
  "name": "1 - New expense (Webhook)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "new-expense", "responseMode": "responseNode", "options": {} },
      "id": "a1", "name": "Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "webhookId": "new-expense"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.body.amount }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a2", "name": "amount > 0", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST", "url": "http://server:3105/expenses", "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "title", "value": "={{ $json.body.title }}" },
          { "name": "amount", "value": "={{ $json.body.amount }}" },
          { "name": "category", "value": "={{ $json.body.category || 'כללי' }}" }
        ] },
        "options": {}
      },
      "id": "a3", "name": "POST to server", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, -100]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "{\"ok\": true}", "options": {} },
      "id": "a4", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [660, -100]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "{\"error\": \"amount must be > 0\"}", "options": { "responseCode": 400 } },
      "id": "a5", "name": "Respond 400", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [440, 100]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "amount > 0", "type": "main", "index": 0 }]] },
    "amount > 0": { "main": [[{ "node": "POST to server", "type": "main", "index": 0 }], [{ "node": "Respond 400", "type": "main", "index": 0 }]] },
    "POST to server": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
